# Database (PostgreSQL)
POSTGRES_USER=securechat
POSTGRES_PASSWORD=securechat_secret_pw
POSTGRES_DB=securechat_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://securechat:securechat_secret_pw@localhost:5432/securechat_db

# API Server
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=development_jwt_access_secret_super_secure_key_32chars!
JWT_REFRESH_SECRET=development_jwt_refresh_secret_super_secure_key_32chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin (Push Notifications)
FIREBASE_PROJECT_ID=securechat-placeholder
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@securechat-placeholder.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3placeholder\n-----END PRIVATE KEY-----\n"

# Mobile Client (apps/mobile)
API_HTTP_URL=http://10.0.2.2:4000/graphql
API_WS_URL=ws://10.0.2.2:4000/graphql
